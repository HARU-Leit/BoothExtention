{
	"name": "booth-extention",
	"description": "Boothを快適に - ショップブロック、リダイレクト、高速化",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"postinstall": "wxt prepare",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"tsc": "tsc --noEmit",
		"tsc:src": "tsc --noEmit --project tsconfig.json --exclude 'tests/**/*'",
		"prepare": "lefthook install",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=extension-e2e",
		"test:e2e:ui": "playwright test --ui",
		"test:report": "playwright show-report",
		"validate": "bun run lint && bun run check && bun run test:unit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@playwright/test": "^1.57.0",
		"@types/chrome": "^0.1.31",
		"@vitest/coverage-v8": "^4.0.15",
		"@vitest/ui": "^4.0.14",
		"@wxt-dev/module-svelte": "^2.0.4",
		"jsdom": "^27.2.0",
		"lefthook": "^2.0.4",
		"sass": "^1.94.2",
		"svelte": "^5.45.2",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.4",
		"vitest": "^4.0.14",
		"wxt": "^0.20.11"
	},
	"dependencies": {
		"zod": "^4.1.13"
	}
}
